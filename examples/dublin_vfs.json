{
  "metadata": {
    "name": "Dublin Schengen slot watch (VFS Global template)",
    "notes": "Template only: configure only endpoints you are allowed to access and comply with portal terms and local law."
  },
  "poll_interval": 900,
  "jitter": 180,
  "earliest": "2026-09-01",
  "latest": "2027-03-31",
  "state_file": ".openclaw/dublin-vfs-state.json",
  "notifiers": [
    { "type": "console" }
  ],
  "watches": [
    {
      "country_from": "IE",
      "country_to": "FR",
      "city": "Dublin",
      "visa_category": "short-stay",
      "provider": "vfs-global",
      "options": {
        "base_url": "https://vfs.example.invalid",
        "availability_path": "/api/appointments/availability",
        "centre_code": "DUBLIN",
        "category_code": "SCHENGEN_SHORT_STAY",
        "sub_category_code": "TOURISM",
        "mission_code": "FRA",
        "query": { "client": "openclaw" },
        "booking_path": "/booking/start",
        "headers": {
          "Accept": "application/json",
          "X-Api-Token": "${OPENCLAW_VFS_TOKEN}"
        },
        "response": {
          "items_path": "data.days",
          "date_key": "date",
          "date_format": "%Y-%m-%d",
          "times_key": "times",
          "time_key": "time",
          "seats_key": "count",
          "booking_url_key": "bookingUrl"
        },
        "auth": {
          "type": "token",
          "login_url": "https://vfs.example.invalid/api/auth/login",
          "body": {
            "username": "${OPENCLAW_VFS_USER}",
            "password": "${OPENCLAW_VFS_PASS}"
          },
          "token_key": "access_token",
          "expires_key": "expires_in",
          "header": "Authorization",
          "header_format": "******"
        }
      }
    }
  ]
}
