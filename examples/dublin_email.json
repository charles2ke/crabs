{
  "metadata": {
    "name": "Dublin Schengen slot watch with email alerts",
    "notes": "Offline example using the mock provider. SMTP credentials are read from the environment."
  },
  "poll_interval": 600,
  "jitter": 120,
  "state_file": ".openclaw/dublin-email-state.json",
  "notifiers": [
    {
      "type": "email",
      "host": "smtp.example.invalid",
      "port": 587,
      "use_tls": true,
      "sender": "openclaw@example.invalid",
      "recipients": [
        "applicant@example.invalid"
      ],
      "username": "${OPENCLAW_SMTP_USERNAME}",
      "password": "${OPENCLAW_SMTP_PASSWORD}"
    }
  ],
  "watches": [
    {
      "country_from": "IE",
      "country_to": "FR",
      "city": "Dublin",
      "visa_category": "short-stay",
      "provider": "mock",
      "options": {
        "slots": [
          {
            "in_days": 14,
            "time": "09:20",
            "seats": 2,
            "booking_url": "https://example.invalid/dublin/fr/book"
          },
          {
            "in_days": 32,
            "time": "11:00",
            "seats": 1,
            "booking_url": "https://example.invalid/dublin/fr/book"
          }
        ]
      }
    }
  ]
}
